# Cloudflare Workers static-asset headers for the closed beta (ignored by vite preview).
# Responses from the API (/v1/*, /livez, /healthz) come through the tunnel and are not affected.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Vite content-hashes every file name under /assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache so a rotation or revocation reaches verifiers quickly.
/.well-known/truerolls-keys.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
