{
  "name": "loom-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixtures:generate": "node ../../scripts/generate-browser-fixtures.mjs",
    "fixtures:check": "node ../../scripts/generate-browser-fixtures.mjs --check",
    "bundle:check": "node ../../scripts/bundle-report.mjs",
    "build": "tsc -b && vite build",
    "build:beta": "tsc -b && vite build --mode closed-beta",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test --project=service-free-desktop --project=service-free-mobile --project=production-mode-desktop",
    "test:e2e:live": "playwright test --project=live-drand-desktop",
    "perf:observe": "node scripts/performance-observation.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "kd-core-wasm": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.61.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.9"
  }
}
