# Home-PC closed beta: every variable infra/docker-compose.beta.yml reads.
#
# Do not fill this file in. Create the real one, outside the repository and readable only by you,
# with `pwsh -File scripts/beta-secrets.ps1`; it generates every secret below. The default location
# is %LOCALAPPDATA%\TrueRolls\beta\beta.env.

# Locally built kd-api image, tagged with the commit it was built from.
KD_API_IMAGE=truerolls-kd-api:beta-<commit>

# Receipt signer: one fresh Ed25519 seed (64 hex) and its kid. Production rejects the published
# test seeds, keys and kids. Losing this seed means rotating the key; leaking it means revoking it.
KD_SIGNING_ED25519_SECRET=<64 hex, generated>
KD_SIGNING_KID=trb-<yyyy-mm>

# Service credentials (hex, generated). MinIO secrets are 40 characters, its maximum.
POSTGRES_ADMIN_PASSWORD=<generated>
KD_DB_APP_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
MINIO_ROOT_USER=<generated>
MINIO_ROOT_PASSWORD=<generated>
KD_S3_ACCESS_KEY=kd-api
KD_S3_SECRET_KEY=<generated>

# Mint budget per 3600 s window. Must stay above the per-IP bound of 365.
KD_ROLL_GLOBAL_CAP=1000

# Paste the token of the `truerolls-beta` tunnel from Cloudflare Zero Trust, then set
# COMPOSE_PROFILES=tunnel to start cloudflared. Leave both empty to run with no public path.
TUNNEL_TOKEN=
COMPOSE_PROFILES=
