POSTGRES_USER=kd
POSTGRES_PASSWORD=kd_dev_only_pw
POSTGRES_DB=kd
# Force password auth for TCP; allow local socket trust for admin
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=trust

# (redis/minio if you need them)
REDIS_PASSWORD=kd_dev_only
MINIO_ROOT_USER=kdadmin
MINIO_ROOT_PASSWORD=kd_dev_only_123
S3_BUCKET=kd-transcripts

# drand quicknet relays for per-roll TrueRolls.
DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh
DRAND_TIMEOUT_MS=2500
DRAND_CLIENT_MAX_LAG_ROUNDS=2
DRAND_TARGET_WAIT_MS=12000

# kd-api L2 hardening knobs.
# peer = use the TCP peer IP only. This is the safe local default.
# Production behind a proxy should set one of: xff:<trusted-hop-count>, cloudflare, fly.
KD_TRUSTED_PROXY=peer
# In KD_ENV=prod, peer mode fails closed unless this is explicitly enabled.
# KD_ALLOW_PEER_IP=1
# Per-IP limits: replenish one request every PERIOD seconds, up to BURST.
# Mint limits are separate from verify/read limits. In KD_ENV=prod, startup is refused when
# KD_ROLL_RL_BURST + ceil(KD_ROLL_GLOBAL_CAP_WINDOW_SECS / KD_ROLL_RL_PERIOD_SECS) >= KD_ROLL_GLOBAL_CAP.
# A public-demo starting point is period 10, burst 5 (bound 365 per hour), with a cap well above that.
KD_ROLL_RL_PERIOD_SECS=1
KD_ROLL_RL_BURST=60
KD_VERIFY_RL_PERIOD_SECS=1
KD_VERIFY_RL_BURST=120
KD_READ_RL_PERIOD_SECS=1
KD_READ_RL_BURST=240
KD_ROLL_MAX_INFLIGHT=32
KD_DB_MAX_CONNECTIONS=5
# Optional override. Default is computed from drand relay count and timeout budgets.
# KD_ROLL_TIMEOUT_MS=44000

# Global mint cap (OPS-AUTH-01): max receipts minted per window across ALL clients, on top of the
# per-IP rate limit. This is the total cost/blast-radius ceiling for the unauthenticated signing
# endpoint. 0 = uncapped. In KD_ENV=prod, uncapped fails closed unless KD_ALLOW_UNCAPPED_ROLL=1.
KD_ROLL_GLOBAL_CAP=0
KD_ROLL_GLOBAL_CAP_WINDOW_SECS=3600
# KD_ALLOW_UNCAPPED_ROLL=1
