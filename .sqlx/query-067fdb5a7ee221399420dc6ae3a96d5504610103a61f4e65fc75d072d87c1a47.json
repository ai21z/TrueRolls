  "query": "\n        SELECT public_id, die, kappa, seed, face, ev, alpha, kl, created_at,\n               idem_payload_sha256,\n               (SELECT s3_key FROM transcripts_meta WHERE roll_id = rolls.id LIMIT 1) AS \"s3_key?\"\n        FROM rolls\n        WHERE idempotency_key = $1\n        ORDER BY id DESC\n        LIMIT 1\n        ",
