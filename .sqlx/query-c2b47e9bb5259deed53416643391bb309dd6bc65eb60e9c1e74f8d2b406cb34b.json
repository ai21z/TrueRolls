  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            rolls.public_id,\n            rolls.die,\n            rolls.kappa,\n            rolls.seed,\n            rolls.face,\n            rolls.ev,\n            rolls.alpha,\n            rolls.kl,\n            rolls.created_at,\n            rolls.idem_payload_sha256 AS \"idem_payload_sha256?\",\n            (SELECT s3_key FROM transcripts_meta WHERE roll_id = rolls.id LIMIT 1) AS \"s3_key?\"\n        FROM rolls\n        WHERE rolls.idempotency_key = $1\n        ORDER BY rolls.id DESC\n        LIMIT 1\n        ",
